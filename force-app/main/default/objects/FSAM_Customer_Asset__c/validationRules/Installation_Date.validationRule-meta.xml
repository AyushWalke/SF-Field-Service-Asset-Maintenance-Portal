<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Installation_Date</fullName>
    <active>true</active>
    <errorConditionFormula>FSAM_Installation_Date__c &gt; TODAY()</errorConditionFormula>
    <errorDisplayField>FSAM_Installation_Date__c</errorDisplayField>
    <errorMessage>Installation date cannot be in the future.</errorMessage>
</ValidationRule>
