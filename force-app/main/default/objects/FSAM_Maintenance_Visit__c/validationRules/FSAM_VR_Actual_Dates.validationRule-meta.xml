<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>FSAM_VR_Actual_Dates</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(FSAM_Actual_Start__c)),
    NOT(ISBLANK(FSAM_Actual_End__c)),
    FSAM_Actual_End__c &lt; FSAM_Actual_Start__c
)</errorConditionFormula>
    <errorDisplayField>FSAM_Actual_End__c</errorDisplayField>
    <errorMessage>Actual End cannot be earlier than Actual Start.</errorMessage>
</ValidationRule>
