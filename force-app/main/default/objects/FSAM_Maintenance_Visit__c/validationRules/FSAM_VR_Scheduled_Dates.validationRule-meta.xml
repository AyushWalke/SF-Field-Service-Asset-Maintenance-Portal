<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>FSAM_VR_Scheduled_Dates</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(FSAM_Scheduled_End__c)),
    FSAM_Scheduled_End__c &lt; FSAM_Scheduled_Start__c
)</errorConditionFormula>
    <errorDisplayField>FSAM_Scheduled_End__c</errorDisplayField>
    <errorMessage>Scheduled End cannot be earlier than Scheduled Start.</errorMessage>
</ValidationRule>
