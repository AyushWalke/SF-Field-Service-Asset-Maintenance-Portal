<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>FSAM_VR_SLA_Due_Date</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(FSAM_SLA_Due_Date__c)),
    FSAM_SLA_Due_Date__c &lt; FSAM_Open_Date__c
)</errorConditionFormula>
    <errorDisplayField>FSAM_SLA_Due_Date__c</errorDisplayField>
    <errorMessage>SLA Due Date must be on or after the Open Date.</errorMessage>
</ValidationRule>
