<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>FSAM_VR_Resolution</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(FSAM_Status__c, &quot;Closed&quot;),
    ISBLANK(FSAM_Resolution__c)
)</errorConditionFormula>
    <errorDisplayField>FSAM_Resolution__c</errorDisplayField>
    <errorMessage>Resolution is required before closing the service request.</errorMessage>
</ValidationRule>
