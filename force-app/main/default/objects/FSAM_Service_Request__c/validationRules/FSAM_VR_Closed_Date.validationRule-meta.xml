<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>FSAM_VR_Closed_Date</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
 ISPICKVAL( FSAM_Status__c , &quot;Closed&quot;),
 ISBLANK( FSAM_Closed_Date__c )  
)</errorConditionFormula>
    <errorDisplayField>FSAM_Closed_Date__c</errorDisplayField>
    <errorMessage>Closed Date is required when the request status is Closed.</errorMessage>
</ValidationRule>
