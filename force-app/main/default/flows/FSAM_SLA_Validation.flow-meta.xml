<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Default_SLA_Due_Date</name>
        <label>Set Default SLA Due Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.FSAM_SLA_Due_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>frmDefaultSLADueDate</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Past_SLA</targetReference>
        </connector>
    </assignments>
    <customErrors>
        <name>Must_Have_Closed_Date</name>
        <label>Must Have Closed Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>Closed Service Requests must have a Closed Date.</errorMessage>
            <fieldSelection>FSAM_Closed_Date__c</fieldSelection>
            <isFieldError>true</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <name>Past_SLA_Due_Date</name>
        <label>Past SLA Due Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>SLA Due Date cannot be in the past.</errorMessage>
            <fieldSelection>FSAM_SLA_Due_Date__c</fieldSelection>
            <isFieldError>true</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Closed_Without_Date</name>
        <label>Closed Without Date?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Has Closed Date</defaultConnectorLabel>
        <rules>
            <name>Missing_Closed_Date</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.FSAM_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.FSAM_Closed_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Must_Have_Closed_Date</targetReference>
            </connector>
            <label>Missing Closed Date</label>
        </rules>
    </decisions>
    <decisions>
        <name>Past_SLA</name>
        <label>Past SLA?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Closed_Without_Date</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Valid</defaultConnectorLabel>
        <rules>
            <name>Past_Due</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>frmSLADate</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Past_SLA_Due_Date</targetReference>
            </connector>
            <label>Past Due</label>
        </rules>
    </decisions>
    <decisions>
        <name>SLA_Due_Date_Blank</name>
        <label>SLA Due Date Blank?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Past_SLA</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Has Due Date</defaultConnectorLabel>
        <rules>
            <name>Blank</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.FSAM_SLA_Due_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Default_SLA_Due_Date</targetReference>
            </connector>
            <label>Blank</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>frmDefaultSLADueDate</name>
        <dataType>DateTime</dataType>
        <expression>{!$Record.FSAM_Open_Date__c} + 3</expression>
    </formulas>
    <formulas>
        <name>frmSLADate</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!$Record.FSAM_SLA_Due_Date__c})</expression>
    </formulas>
    <interviewLabel>FSAM - SLA Validation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>FSAM - SLA Validation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>SLA_Due_Date_Blank</targetReference>
        </connector>
        <filterFormula>OR(
    ISNEW(),
    ISCHANGED({!$Record.FSAM_SLA_Due_Date__c}),
    ISCHANGED({!$Record.FSAM_Status__c}),
    ISCHANGED({!$Record.FSAM_Closed_Date__c})
)</filterFormula>
        <object>FSAM_Service_Request__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
